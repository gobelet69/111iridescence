---
interface Props {
  href?: string;
}

const { href = '/' } = Astro.props;
---

<a class="brand-mark type-identity" href={href} aria-label="111iridescence.">
  <svg class="brand-symbol" viewBox="0 0 64 64" width="22" height="22" fill="none" aria-hidden="true">
    <rect x="0" y="0" width="64" height="64" rx="14" fill="#16101D" />
    <rect x="1" y="1" width="62" height="62" rx="13" stroke="#702EE4" stroke-opacity="0.34" stroke-width="1" />
    <!-- 1st pixel '1' (Cyan -> Electric Blue) -->
    <rect x="8.38" y="16.38" width="3.25" height="3.25" rx="0.7" fill="#0CC0E8" />
    <rect x="4.38" y="20.38" width="3.25" height="3.25" rx="0.7" fill="#0CC0E8" />
    <rect x="8.38" y="20.38" width="3.25" height="3.25" rx="0.7" fill="#0CC0E8" />
    <rect x="8.38" y="24.38" width="3.25" height="3.25" rx="0.7" fill="#2266F2" />
    <rect x="8.38" y="28.38" width="3.25" height="3.25" rx="0.7" fill="#2266F2" />
    <rect x="8.38" y="32.38" width="3.25" height="3.25" rx="0.7" fill="#2266F2" />
    <rect x="8.38" y="36.38" width="3.25" height="3.25" rx="0.7" fill="#2266F2" />
    <rect x="8.38" y="40.38" width="3.25" height="3.25" rx="0.7" fill="#2266F2" />
    <rect x="8.38" y="44.38" width="3.25" height="3.25" rx="0.7" fill="#2266F2" />
    <rect x="4.38" y="48.38" width="3.25" height="3.25" rx="0.7" fill="#2266F2" />
    <rect x="8.38" y="48.38" width="3.25" height="3.25" rx="0.7" fill="#2266F2" />
    <rect x="12.38" y="48.38" width="3.25" height="3.25" rx="0.7" fill="#2266F2" />
    <!-- 2nd pixel '1' (Electric Blue -> Deep Violet) -->
    <rect x="24.38" y="16.38" width="3.25" height="3.25" rx="0.7" fill="#2266F2" />
    <rect x="20.38" y="20.38" width="3.25" height="3.25" rx="0.7" fill="#2266F2" />
    <rect x="24.38" y="20.38" width="3.25" height="3.25" rx="0.7" fill="#2266F2" />
    <rect x="24.38" y="24.38" width="3.25" height="3.25" rx="0.7" fill="#4852EC" />
    <rect x="24.38" y="28.38" width="3.25" height="3.25" rx="0.7" fill="#4852EC" />
    <rect x="24.38" y="32.38" width="3.25" height="3.25" rx="0.7" fill="#4852EC" />
    <rect x="24.38" y="36.38" width="3.25" height="3.25" rx="0.7" fill="#702EE4" />
    <rect x="24.38" y="40.38" width="3.25" height="3.25" rx="0.7" fill="#702EE4" />
    <rect x="24.38" y="44.38" width="3.25" height="3.25" rx="0.7" fill="#702EE4" />
    <rect x="20.38" y="48.38" width="3.25" height="3.25" rx="0.7" fill="#702EE4" />
    <rect x="24.38" y="48.38" width="3.25" height="3.25" rx="0.7" fill="#702EE4" />
    <rect x="28.38" y="48.38" width="3.25" height="3.25" rx="0.7" fill="#702EE4" />
    <!-- 3rd pixel '1' (Ultraviolet -> Deep Violet) -->
    <rect x="40.38" y="16.38" width="3.25" height="3.25" rx="0.7" fill="#8A38F5" />
    <rect x="36.38" y="20.38" width="3.25" height="3.25" rx="0.7" fill="#8A38F5" />
    <rect x="40.38" y="20.38" width="3.25" height="3.25" rx="0.7" fill="#8A38F5" />
    <rect x="40.38" y="24.38" width="3.25" height="3.25" rx="0.7" fill="#702EE4" />
    <rect x="40.38" y="28.38" width="3.25" height="3.25" rx="0.7" fill="#702EE4" />
    <rect x="40.38" y="32.38" width="3.25" height="3.25" rx="0.7" fill="#702EE4" />
    <rect x="40.38" y="36.38" width="3.25" height="3.25" rx="0.7" fill="#8A38F5" />
    <rect x="40.38" y="40.38" width="3.25" height="3.25" rx="0.7" fill="#8A38F5" />
    <rect x="40.38" y="44.38" width="3.25" height="3.25" rx="0.7" fill="#8A38F5" />
    <rect x="36.38" y="48.38" width="3.25" height="3.25" rx="0.7" fill="#8A38F5" />
    <rect x="40.38" y="48.38" width="3.25" height="3.25" rx="0.7" fill="#8A38F5" />
    <rect x="44.38" y="48.38" width="3.25" height="3.25" rx="0.7" fill="#8A38F5" />
    <!-- Terminal period '.' (Controlled Turquoise) -->
    <rect x="52.38" y="44.38" width="3.25" height="3.25" rx="0.7" fill="#12CCB8" />
    <rect x="52.38" y="48.38" width="3.25" height="3.25" rx="0.7" fill="#0CC0E8" />
    <!-- Signature 5-cell pixel star (`cross-5`) -->
    <rect x="52.38" y="16.38" width="3.25" height="3.25" rx="0.7" fill="#E0FAFF" />
    <rect x="52.38" y="12.38" width="3.25" height="3.25" rx="0.7" fill="#0CC0E8" />
    <rect x="48.38" y="16.38" width="3.25" height="3.25" rx="0.7" fill="#2266F2" />
    <rect x="56.38" y="16.38" width="3.25" height="3.25" rx="0.7" fill="#DC3EA0" />
    <rect x="52.38" y="20.38" width="3.25" height="3.25" rx="0.7" fill="#702EE4" />
  </svg>
  <span>111iridescence.</span>
</a>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.2rem);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .brand-mark:hover {
    opacity: 0.85;
  }

  .brand-symbol {
    flex: 0 0 auto;
    transition: transform var(--transition-fast);
  }

  .brand-mark:hover .brand-symbol {
    transform: scale(1.08);
  }
</style>
