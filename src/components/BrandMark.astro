---
interface Props {
  href?: string;
}

const { href = '/' } = Astro.props;
---

<a class="brand-mark type-identity" href={href} aria-label="111iridescence.">
  <svg class="brand-symbol" viewBox="0 0 64 64" width="22" height="22" fill="none" aria-hidden="true">
    <rect x="0" y="0" width="64" height="64" rx="14" fill="#16101D" />
    <rect x="1" y="1" width="62" height="62" rx="13" stroke="#8A38F5" stroke-opacity="0.38" stroke-width="1.2" />
    <!-- Subtle background matrix nodes -->
    <rect x="15" y="15" width="2" height="2" rx="0.5" fill="#702EE4" fill-opacity="0.22" />
    <rect x="47" y="15" width="2" height="2" rx="0.5" fill="#702EE4" fill-opacity="0.22" />
    <rect x="15" y="47" width="2" height="2" rx="0.5" fill="#702EE4" fill-opacity="0.22" />
    <rect x="47" y="47" width="2" height="2" rx="0.5" fill="#702EE4" fill-opacity="0.22" />
    <!-- Ambient electronic signal pixels -->
    <rect x="13.75" y="13.75" width="4.5" height="4.5" rx="0.9" fill="#0CC0E8" fill-opacity="0.42" />
    <rect x="45.75" y="45.75" width="4.5" height="4.5" rx="0.9" fill="#702EE4" fill-opacity="0.48" />
    <!-- Tier 3: Outer cardinal tips -->
    <rect x="28.75" y="12.75" width="6.5" height="6.5" rx="1.3" fill="#0CC0E8" />
    <rect x="12.75" y="28.75" width="6.5" height="6.5" rx="1.3" fill="#2266F2" />
    <rect x="44.75" y="28.75" width="6.5" height="6.5" rx="1.3" fill="#8A38F5" />
    <rect x="28.75" y="44.75" width="6.5" height="6.5" rx="1.3" fill="#702EE4" />
    <!-- Tier 2: Diagonal glints -->
    <rect x="20.75" y="20.75" width="6.5" height="6.5" rx="1.3" fill="#2266F2" fill-opacity="0.88" />
    <rect x="36.75" y="20.75" width="6.5" height="6.5" rx="1.3" fill="#DC3EA0" fill-opacity="0.88" />
    <rect x="20.75" y="36.75" width="6.5" height="6.5" rx="1.3" fill="#702EE4" fill-opacity="0.88" />
    <rect x="36.75" y="36.75" width="6.5" height="6.5" rx="1.3" fill="#8A38F5" fill-opacity="0.88" />
    <!-- Tier 1: Inner cardinal cross -->
    <rect x="28.75" y="20.75" width="6.5" height="6.5" rx="1.3" fill="#12CCB8" />
    <rect x="20.75" y="28.75" width="6.5" height="6.5" rx="1.3" fill="#0CC0E8" />
    <rect x="36.75" y="28.75" width="6.5" height="6.5" rx="1.3" fill="#2266F2" />
    <rect x="28.75" y="36.75" width="6.5" height="6.5" rx="1.3" fill="#8A38F5" />
    <!-- Tier 0: Luminous core -->
    <rect x="28.75" y="28.75" width="6.5" height="6.5" rx="1.3" fill="#E0FAFF" />
  </svg>
  <span>111iridescence.</span>
</a>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.2rem);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .brand-mark:hover {
    opacity: 0.85;
  }

  .brand-symbol {
    flex: 0 0 auto;
    transition: transform var(--transition-fast);
  }

  .brand-mark:hover .brand-symbol {
    transform: scale(1.08);
  }
</style>
