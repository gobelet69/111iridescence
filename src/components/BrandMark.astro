---
interface Props {
  href?: string;
}

const { href = '/' } = Astro.props;
---

<a class="brand-mark type-identity" href={href} aria-label="111iridescence.">
  <svg class="brand-symbol" viewBox="0 0 256 256" width="20" height="20" fill="none" aria-hidden="true">
    <path d="M 74 68 L 96 68 L 96 188 L 74 188 L 74 90 L 60 104 L 60 82 Z" fill="currentColor"/>
    <path d="M 122 68 L 144 68 L 144 188 L 122 188 L 122 90 L 108 104 L 108 82 Z" fill="currentColor"/>
    <path d="M 170 68 L 192 68 L 192 188 L 170 188 L 170 90 L 156 104 L 156 82 Z" fill="var(--violet-text, #4F46E5)"/>
  </svg>
  <span>111iridescence.</span>
</a>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.2rem);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .brand-mark:hover {
    opacity: 0.85;
  }

  .brand-symbol {
    flex: 0 0 auto;
    transition: transform var(--transition-fast);
  }

  .brand-mark:hover .brand-symbol {
    transform: scale(1.08);
  }
</style>
