---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length >= 3 && (
  <nav class="table-of-contents" aria-label="Sur cette page">
    <p class="toc-title type-metadata">Sur cette page</p>
    <ol>
      {items.map((heading) => (
        <li class:list={{ nested: heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .table-of-contents {
    padding-inline-start: var(--space-5);
    border-inline-start: 1px solid var(--line);
  }

  .toc-title {
    margin: 0 0 var(--space-3);
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 700;
  }

  ol {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li.nested {
    padding-inline-start: var(--space-3);
  }

  a {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.35;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:hover {
    color: var(--ink);
  }
</style>
