---
import type { CatalogProject } from '../lib/project-catalog';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CatalogProject[];
}

const { projects } = Astro.props;
const pinCount = Math.min(6, Math.max(1, projects.length));
---

<div class={`pinned-grid pins-${pinCount}`} data-pin-count={projects.length}>
  {projects.map((project, index) => (
    <div class="pinned-item" data-pinned-project>
      <ProjectCard project={project} position={index + 1} />
    </div>
  ))}
</div>

<style>
  .pinned-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  .pinned-item {
    display: grid;
    min-width: 0;
  }

  @media (min-width: 48rem) and (max-width: 67.999rem) {
    .pinned-grid:not(.pins-1) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pins-3 .pinned-item:last-child,
    .pins-5 .pinned-item:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 68rem) {
    .pins-2,
    .pins-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pins-3,
    .pins-6 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pins-5 {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .pins-5 .pinned-item {
      grid-column: span 2;
    }

    .pins-5 .pinned-item:nth-child(4) {
      grid-column: 2 / span 2;
    }

    .pins-5 .pinned-item:nth-child(5) {
      grid-column: 4 / span 2;
    }
  }
</style>
