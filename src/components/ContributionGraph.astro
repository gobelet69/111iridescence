---
interface ContributionDay {
  date: string;
  count: number;
  level: number;
}

interface ContributionWeek {
  firstDay: string;
  days: ContributionDay[];
}

interface Props {
  calendar: {
    totalContributions: number;
    startsAt: string;
    endsAt: string;
    weeks: ContributionWeek[];
  };
}

const { calendar } = Astro.props;
const longDate = new Intl.DateTimeFormat('fr-BE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const shortMonth = new Intl.DateTimeFormat('fr-BE', {
  month: 'short',
  timeZone: 'UTC',
});
const dateValue = (date: string) => new Date(`${date}T12:00:00Z`);
const formatDate = (date: string) => longDate.format(dateValue(date));
const accessibleLabel = `${calendar.totalContributions} contributions GitHub du ${formatDate(calendar.startsAt)} au ${formatDate(calendar.endsAt)}`;
let previousMonth = -1;
const monthLabels = calendar.weeks.flatMap((week, index) => {
  const date = dateValue(week.firstDay);
  const month = date.getUTCMonth();
  if (month === previousMonth) return [];
  previousMonth = month;
  return [{ index, label: shortMonth.format(date).replace('.', '') }];
});
---

<div class="contribution-frame">
  <div class="contribution-heading">
    <p class="type-metadata">Activité GitHub</p>
    <p>{calendar.totalContributions} contributions sur la période</p>
  </div>

  <div class="contribution-scroll" data-contribution-scroll tabindex="0" aria-label="Faire défiler le calendrier GitHub">
    <div class="contribution-graph" role="img" aria-label={accessibleLabel}>
      <div class="month-labels" aria-hidden="true">
        {monthLabels.map((month) => (
          <span style={`grid-column:${month.index + 1}`}>{month.label}</span>
        ))}
      </div>
      <div class="graph-body">
        <div class="weekday-labels type-metadata" aria-hidden="true">
          <span>Lun</span>
          <span>Mer</span>
          <span>Ven</span>
        </div>
        <div class="contribution-cells" aria-hidden="true">
          {calendar.weeks.flatMap((week) => week.days.map((day) => (
            <span
              class={`contribution-day level-${day.level}`}
              data-contribution-day
              title={`${formatDate(day.date)} : ${day.count} contribution${day.count === 1 ? '' : 's'}`}
            />
          )))}
        </div>
      </div>
      <div class="legend type-metadata" aria-hidden="true">
        <span>moins</span>
        {[0, 1, 2, 3, 4].map((level) => <i class={`level-${level}`} />)}
        <span>plus</span>
      </div>
    </div>
  </div>
</div>

<script>
  for (const scroller of document.querySelectorAll<HTMLElement>('[data-contribution-scroll]')) {
    scroller.scrollLeft = scroller.scrollWidth;
  }
</script>

<style>
  .contribution-frame {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-strong);
  }

  .contribution-heading {
    display: flex;
    padding: var(--space-4) var(--space-5);
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    gap: var(--space-4);
  }

  .contribution-heading p {
    margin: 0;
  }

  .contribution-heading p:first-child {
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .contribution-heading p:last-child {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .contribution-scroll {
    max-width: 100%;
    overflow-x: auto;
    padding: var(--space-5);
    overscroll-behavior-inline: contain;
    scrollbar-color: var(--line) transparent;
  }

  .contribution-scroll:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }

  .contribution-graph {
    width: max-content;
    min-width: 46rem;
  }

  .month-labels {
    display: grid;
    padding-left: 2.8rem;
    grid-template-columns: repeat(53, 0.72rem);
    gap: 0.2rem;
    min-height: 1.4rem;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.68rem;
  }

  .month-labels span {
    white-space: nowrap;
  }

  .graph-body {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .weekday-labels {
    display: grid;
    width: 2rem;
    grid-template-rows: repeat(3, 1.64rem);
    color: var(--muted);
    font-size: 0.65rem;
    line-height: 0.72rem;
  }

  .contribution-cells {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 0.72rem);
    grid-auto-columns: 0.72rem;
    gap: 0.2rem;
  }

  .contribution-day,
  .legend i {
    width: 0.72rem;
    height: 0.72rem;
    border: 1px solid color-mix(in srgb, var(--line) 72%, transparent);
    border-radius: 0.12rem;
    background: color-mix(in srgb, var(--line) 32%, transparent);
  }

  .level-1 {
    background: color-mix(in srgb, var(--presence) 30%, var(--paper-strong));
  }

  .level-2 {
    background: color-mix(in srgb, var(--presence) 52%, var(--paper-strong));
  }

  .level-3 {
    background: color-mix(in srgb, var(--presence) 74%, var(--ink));
  }

  .level-4 {
    background: color-mix(in srgb, var(--presence) 68%, var(--ink));
  }

  .legend {
    display: flex;
    margin-top: var(--space-4);
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    color: var(--muted);
    font-size: 0.65rem;
  }

  .legend i {
    display: block;
  }

  @media (max-width: 40rem) {
    .contribution-heading {
      display: grid;
      gap: var(--space-1);
    }

    .contribution-scroll {
      padding-inline: var(--space-4);
    }
  }
</style>
