---
import type { Locale } from '../../i18n';
import { pageCopy } from '../../i18n/pages';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = pageCopy(locale).product;
---
<div class="order-demo" aria-label={copy.orderLabel}>
  <div class="order-demo__toolbar type-metadata">
    <h3>{copy.orderLabel}</h3>
    <span>{copy.documents}</span>
  </div>
  <ol>
    <li><span>01</span><strong>{copy.cover}</strong><small>1 {copy.page}</small></li>
    <li><span>02</span><strong>{copy.report}</strong><small>24 {copy.pages}</small></li>
    <li><span>03</span><strong>{copy.appendices}</strong><small>8 {copy.pages}</small></li>
    <li><span>04</span><strong>{copy.notes}</strong><small>2 {copy.pages}</small></li>
  </ol>
  <p>{copy.orderHelp}</p>
</div>

<style>
  .order-demo {
    overflow: hidden;
    border: 1px solid var(--glass-line);
    border-radius: var(--radius-large);
    background: var(--glass);
    box-shadow: var(--shadow-window);
    backdrop-filter: blur(20px);
  }

  .order-demo__toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--glass-line);
    background: color-mix(in srgb, var(--paper-strong) 60%, transparent);
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .order-demo__toolbar h3 {
    margin: 0;
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .order-demo__toolbar span {
    display: inline-flex;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--glass);
    border: 1px solid var(--glass-line);
    font-size: 0.7rem;
    font-weight: 700;
  }

  ol {
    margin: 0;
    padding: var(--space-2);
    list-style: none;
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    margin-block: 0.15rem;
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  li:hover {
    background: color-mix(in srgb, var(--paper-strong) 80%, transparent);
  }

  li span {
    display: inline-flex;
    width: 1.6rem;
    height: 1.6rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--blue) 12%, transparent);
    color: var(--blue-text);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  li small {
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  li strong {
    min-width: 0;
    overflow: hidden;
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .order-demo > p {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--glass-line);
    background: color-mix(in srgb, var(--paper-strong) 40%, transparent);
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.5;
  }
</style>
