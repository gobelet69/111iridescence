---
import type { AppDefinition } from '../../data/apps';
import { getRoute, type Locale } from '../../i18n';
import { pageCopy } from '../../i18n/pages';
import AppIcon from './AppIcon.astro';
import AppScreenshot from './AppScreenshot.astro';
import ReleaseDownload from './ReleaseDownload.astro';

interface Props {
  app: AppDefinition;
  index: number;
  locale: Locale;
}

const { app, index, locale } = Astro.props;
const copy = pageCopy(locale).product;
---

<article class:list={['product-chapter', `product-chapter--${app.accent}`, `product-chapter--${app.slug}`, index % 2 === 1 && 'product-chapter--reverse']}>
  <div class="product-chapter__copy">
    <div class="product-chapter__identity">
      <span class="product-chapter__icon-frame" aria-hidden="true">
        <AppIcon app={app} size="small" />
      </span>
      <div class="product-chapter__identity-copy type-metadata">
        <span>{app.architecture}</span>
        <p>{copy.macApp} · {app.compatibility}</p>
      </div>
    </div>
    <h3>{app.name}</h3>
    <p class="product-chapter__tagline">{app.tagline}</p>
    <p class="product-chapter__description">{app.description}</p>
    <ul class="product-chapter__highlights" role="list">
      {app.features.slice(0, 3).map((feature) => <li>{feature.title}</li>)}
    </ul>
    <div class="product-chapter__actions">
      <a class="button button--secondary" href={getRoute(locale, 'product', app.slug)}>{copy.discover}</a>
      <ReleaseDownload app={app} locale={locale} compact />
    </div>
  </div>
  <div class="product-chapter__visual">
    <div class="product-chapter__halo" aria-hidden="true"></div>
    <AppScreenshot screenshot={app.primaryScreenshot} eager={index === 0} />
  </div>
</article>

<style>
  .product-chapter {
    --chapter-accent: var(--violet);
    --chapter-accent-text: var(--violet-text);
    display: grid;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    margin-bottom: clamp(3rem, 6vw, 5rem);
    padding: clamp(2.5rem, 5vw, 4.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-large);
    background:
      radial-gradient(ellipse at 15% 15%, color-mix(in srgb, var(--chapter-accent) 6%, transparent), transparent 65%),
      color-mix(in srgb, var(--paper-strong) 92%, transparent);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(20px);
    transition: border-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .product-chapter:hover {
    border-color: color-mix(in srgb, var(--chapter-accent) 30%, var(--line));
    box-shadow: var(--shadow-window);
  }

  .product-chapter--blue {
    --chapter-accent: var(--blue);
    --chapter-accent-text: var(--blue-text);
  }

  .product-chapter--resource-guard {
    --chapter-accent: var(--presence);
    --chapter-accent-text: var(--presence-text);
  }

  .product-chapter__copy {
    position: relative;
    z-index: 2;
    min-width: 0;
  }

  .product-chapter__identity {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .product-chapter__icon-frame {
    display: grid;
    width: 4.25rem;
    height: 4.25rem;
    flex: none;
    place-items: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--chapter-accent) 22%, var(--glass-line));
    border-radius: 1rem;
    background: color-mix(in srgb, var(--paper-strong) 88%, var(--chapter-accent) 12%);
    box-shadow: 0 0.75rem 2rem color-mix(in srgb, var(--ink) 12%, transparent), inset 0 1px 0 oklch(100% 0 0 / 0.8);
  }

  .product-chapter__icon-frame :global(.app-icon) {
    width: 100%;
    height: 100%;
    border-radius: 0.92rem;
    filter: none;
  }

  .product-chapter__identity-copy {
    display: grid;
    gap: 0.2rem;
  }

  .product-chapter__identity-copy span {
    color: var(--chapter-accent-text);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .product-chapter__identity-copy p {
    margin: 0;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
  }

  h3 {
    max-width: 14ch;
    margin-bottom: var(--space-3);
    font-size: var(--step-3);
    letter-spacing: -0.035em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .product-chapter__tagline {
    margin-bottom: var(--space-4);
    color: var(--ink);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .product-chapter__description {
    max-width: 36rem;
    margin-bottom: var(--space-5);
    color: var(--muted);
    font-size: var(--step-0);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .product-chapter__highlights {
    display: flex;
    margin: 0 0 var(--space-5);
    padding: 0;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .product-chapter__highlights li {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--glass-line);
    border-radius: var(--radius-pill);
    background: var(--glass);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    box-shadow: 0 1px 2px oklch(0% 0 0 / 0.04);
  }

  .product-chapter__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .product-chapter__visual {
    position: relative;
    min-width: 0;
  }

  .product-chapter__halo {
    position: absolute;
    inset: 10% 8%;
    border-radius: 50%;
    background: color-mix(in srgb, var(--chapter-accent) 24%, var(--coral) 8%);
    filter: blur(4rem);
    opacity: 0.45;
    pointer-events: none;
  }

  .product-chapter__visual :global(.app-shot) {
    position: relative;
    z-index: 1;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .product-chapter__visual :global(.app-shot:hover) {
    transform: translateY(-2px);
  }

  @media (min-width: 58rem) {
    .product-chapter {
      grid-template-columns: minmax(18rem, 0.78fr) minmax(0, 1.22fr);
    }

    .product-chapter--reverse {
      grid-template-columns: minmax(0, 1.22fr) minmax(18rem, 0.78fr);
    }

    .product-chapter--reverse .product-chapter__copy {
      grid-column: 2;
    }

    .product-chapter--reverse .product-chapter__visual {
      grid-row: 1;
      grid-column: 1;
    }

    h3 {
      min-block-size: 1.9em;
      display: flex;
      align-items: flex-end;
    }
  }

  @media (max-width: 42rem) {
    .product-chapter__actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
