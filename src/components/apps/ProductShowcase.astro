---
import type { AppDefinition } from '../../data/apps';
import AppIcon from './AppIcon.astro';
import AppScreenshot from './AppScreenshot.astro';
import ReleaseDownload from './ReleaseDownload.astro';

interface Props {
  app: AppDefinition;
  index: number;
}

const { app, index } = Astro.props;
---

<article class:list={['product-chapter', `product-chapter--${app.accent}`, index % 2 === 1 && 'product-chapter--reverse']}>
  <div class="product-chapter__copy">
    <div class="product-chapter__identity">
      <AppIcon app={app} size="small" />
      <p class="type-metadata">Application macOS · {String(index + 1).padStart(2, '0')}</p>
    </div>
    <h3>{app.name}</h3>
    <p class="product-chapter__tagline type-identity">{app.tagline}</p>
    <p class="product-chapter__description">{app.description}</p>
    <ul class="product-chapter__highlights" role="list">
      {app.features.slice(0, 3).map((feature) => <li>{feature.title}</li>)}
    </ul>
    <div class="product-chapter__actions">
      <a class="button button--secondary" href={`/apps/${app.slug}`}>Découvrir</a>
      <ReleaseDownload app={app} compact />
    </div>
  </div>
  <div class="product-chapter__visual">
    <div class="product-chapter__halo" aria-hidden="true"></div>
    <AppScreenshot screenshot={app.primaryScreenshot} eager={index === 0} />
  </div>
</article>

<style>
  .product-chapter {
    --chapter-accent: var(--violet);
    display: grid;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(4rem, 10vw, 8rem);
    border-bottom: 1px solid var(--glass-line);
  }

  .product-chapter--blue {
    --chapter-accent: var(--blue);
  }

  .product-chapter__copy {
    position: relative;
    z-index: 2;
  }

  .product-chapter__identity {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .product-chapter__identity p {
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h3 {
    max-width: 12ch;
    margin-bottom: var(--space-3);
    font-size: var(--step-3);
    letter-spacing: -0.055em;
  }

  .product-chapter__tagline {
    margin-bottom: var(--space-4);
    color: var(--chapter-accent);
    font-size: var(--step-1);
  }

  .product-chapter__description {
    max-width: 36rem;
    margin-bottom: var(--space-5);
    color: var(--muted);
    font-size: var(--step-0);
  }

  .product-chapter__highlights {
    display: flex;
    margin: 0 0 var(--space-6);
    padding: 0;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .product-chapter__highlights li {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    background: var(--glass);
    font-family: var(--font-display);
    font-size: 0.72rem;
  }

  .product-chapter__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .product-chapter__visual {
    position: relative;
    min-width: 0;
  }

  .product-chapter__halo {
    position: absolute;
    inset: 10% 8%;
    border-radius: 50%;
    background: color-mix(in srgb, var(--chapter-accent) 28%, var(--coral) 10%);
    filter: blur(4rem);
    opacity: 0.55;
  }

  .product-chapter__visual :global(.app-shot) {
    position: relative;
    z-index: 1;
    transform: rotate(0.6deg);
  }

  .product-chapter--reverse .product-chapter__visual :global(.app-shot) {
    transform: rotate(-0.6deg);
  }

  @media (min-width: 58rem) {
    .product-chapter {
      grid-template-columns: minmax(17rem, 0.72fr) minmax(0, 1.28fr);
    }

    .product-chapter--reverse {
      grid-template-columns: minmax(0, 1.18fr) minmax(18rem, 0.82fr);
    }

    .product-chapter--reverse .product-chapter__copy {
      grid-column: 2;
    }

    .product-chapter--reverse .product-chapter__visual {
      grid-row: 1;
      grid-column: 1;
    }
  }

  @media (max-width: 42rem) {
    .product-chapter__actions {
      flex-direction: column;
    }
  }
</style>
