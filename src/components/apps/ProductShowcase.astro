---
import type { AppDefinition } from '../../data/apps';
import { getRoute, type Locale } from '../../i18n';
import { pageCopy } from '../../i18n/pages';
import AppIcon from './AppIcon.astro';
import AppScreenshot from './AppScreenshot.astro';
import ReleaseDownload from './ReleaseDownload.astro';

interface Props {
  app: AppDefinition;
  index: number;
  locale: Locale;
}

const { app, index, locale } = Astro.props;
const copy = pageCopy(locale).product;
---

<article class:list={['product-chapter', `product-chapter--${app.accent}`, `product-chapter--${app.slug}`, index % 2 === 1 && 'product-chapter--reverse']}>
  <div class="product-chapter__copy">
    <div class="product-chapter__identity">
      <span class="product-chapter__icon-frame" aria-hidden="true">
        <AppIcon app={app} size="small" />
      </span>
      <h3>{app.name}</h3>
    </div>
    <div class="product-chapter__actions">
      <a class="button button--secondary" href={getRoute(locale, 'product', app.slug)} aria-label={`${copy.discover} ${app.name}`}>{copy.discover}</a>
      <ReleaseDownload app={app} locale={locale} variant="button" />
    </div>
  </div>
  <div class="product-chapter__visual">
    <AppScreenshot screenshot={app.primaryScreenshot} eager={index === 0} />
  </div>
</article>

<style>
  .product-chapter {
    --display-field: var(--field-violet);
    display: grid;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(1.5rem, 3vw, 3rem);
    border-block-start: 1px solid var(--line);
  }

  .product-chapter:last-child { padding-block-end: 0; }
  .product-chapter--blue { --display-field: var(--field-blue); }
  .product-chapter--cyan { --display-field: var(--field-cyan); }
  .product-chapter--resource-guard { --display-field: var(--field-green); }

  .product-chapter__copy { min-width: 0; }

  .product-chapter__identity {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .product-chapter__icon-frame { display: grid; width: 3rem; height: 3rem; flex: none; place-items: center; }
  .product-chapter__icon-frame :global(.app-icon) { width: 100%; height: 100%; }
  h3 {
    margin: 0;
    min-width: 0;
    font-size: clamp(1.5rem, 3vw, 2.75rem);
    line-height: 1.08;
    text-wrap: balance;
  }

  .product-chapter__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .product-chapter__visual {
    display: grid;
    min-width: 0;
    place-items: center;
    padding: clamp(1rem, 3.5vw, 3.25rem);
    border-radius: var(--radius-large);
    background: var(--display-field);
  }

  .product-chapter--resource-guard .product-chapter__visual :global(.app-shot) { max-width: 25rem; }

  @media (min-width: 58rem) {
    .product-chapter { grid-template-columns: minmax(17rem, 0.76fr) minmax(0, 1.24fr); }
    .product-chapter--reverse { grid-template-columns: minmax(0, 1.24fr) minmax(17rem, 0.76fr); }
    .product-chapter--reverse .product-chapter__copy { grid-column: 2; }
    .product-chapter--reverse .product-chapter__visual { grid-area: 1 / 1; }
  }
</style>
