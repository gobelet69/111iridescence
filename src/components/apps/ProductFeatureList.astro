---
import type { AppFeature } from '../../data/apps';

interface Props {
  features: AppFeature[];
}

const { features } = Astro.props;
---

<ul class="product-features" role="list">
  {features.map((feature) => (
    <li>
      <h3>{feature.title}</h3>
      <p>{feature.description}</p>
    </li>
  ))}
</ul>
