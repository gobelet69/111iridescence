---
import type { AppDefinition } from '../../data/apps';

interface Props {
  app: AppDefinition;
  compact?: boolean;
}

const { app, compact = false } = Astro.props;
---

<div class:list={['release-download', compact && 'release-download--compact']} data-release-panel={app.slug}>
  <a
    class="button button--primary"
    aria-disabled="true"
    data-release-slug={app.slug}
    data-release-role="link"
  >Bientôt disponible</a>
  <div class="release-download__details type-metadata" aria-live="polite">
    <span data-release-slug={app.slug} data-release-role="version">Version détectée automatiquement</span>
    <span aria-hidden="true">·</span>
    <span data-release-slug={app.slug} data-release-role="format">{app.architecture}</span>
    <span aria-hidden="true">·</span>
    <span>{app.compatibility}</span>
  </div>
  <p hidden data-release-slug={app.slug} data-release-role="notes"></p>
</div>

<script>
  import { mountReleaseDownloads } from '../../scripts/release-download';

  if (!document.documentElement.dataset.releaseDiscoveryMounted) {
    document.documentElement.dataset.releaseDiscoveryMounted = 'true';
    void mountReleaseDownloads();
  }
</script>
