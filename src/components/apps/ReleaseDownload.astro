---
import type { AppDefinition } from '../../data/apps';
import type { Locale } from '../../i18n';
import { pageCopy } from '../../i18n/pages';

interface Props {
  app: AppDefinition;
  variant?: 'full' | 'compact' | 'button';
  locale: Locale;
}

const { app, locale, variant = 'full' } = Astro.props;
const buttonOnly = variant === 'button';
const copy = pageCopy(locale).product;
---

<div class:list={['release-download', variant === 'compact' && 'release-download--compact']} data-release-panel={app.slug}>
  <a
    class="button button--primary"
    href={`https://github.com/${app.repository}/releases`}
    data-release-state="fallback"
    data-release-slug={app.slug}
    data-release-role="link"
  >{copy.viewReleases}</a>
  {!buttonOnly && (
    <div class="release-download__details type-metadata" aria-live="polite">
      <span data-release-slug={app.slug} data-release-role="version">{copy.autoVersion}</span>
      <span aria-hidden="true">·</span>
      <span data-release-slug={app.slug} data-release-role="format">{app.architecture}</span>
      <span aria-hidden="true">·</span>
      <span>{app.compatibility}</span>
    </div>
  )}
  <p
    class:list={['type-metadata', buttonOnly && 'release-download__status--visually-hidden']}
    aria-live="polite"
    data-release-slug={app.slug}
    data-release-role="status"
  ></p>
  {!buttonOnly && (
    <button type="button" class="button" hidden data-release-slug={app.slug} data-release-role="retry">{copy.retryRelease}</button>
  )}
  {variant === 'full' && (
    <details class="release-notes" hidden>
      <summary>{copy.releaseNotes}</summary>
      <p data-release-slug={app.slug} data-release-role="notes"></p>
    </details>
  )}
</div>

<script>
  import { mountReleaseDownloads } from '../../scripts/release-download';

  if (!document.documentElement.dataset.releaseDiscoveryMounted) {
    document.documentElement.dataset.releaseDiscoveryMounted = 'true';
    void mountReleaseDownloads();
  }
</script>

<style>
  .release-download__status--visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
