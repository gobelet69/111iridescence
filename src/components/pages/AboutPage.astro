---
import AboutSignal from '../about/AboutSignal.astro';
import AppIcon from '../apps/AppIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import aboutEn from '../../data/pages/about.en.json';
import aboutFr from '../../data/pages/about.json';
import { getApps } from '../../data/apps';
import { getRoute, type Locale } from '../../i18n';
import { pageCopy } from '../../i18n/pages';
import { validateAboutPage, type AboutSection } from '../../lib/about';

interface Props { locale: Locale }
const { locale } = Astro.props;
const about = validateAboutPage(locale === 'fr' ? aboutFr : aboutEn);
const copy = pageCopy(locale).about;
const apps = getApps(locale);
const sectionMap = new Map(about.sections.map((item) => [item.id, item]));
const section = (id: string): AboutSection => {
  const item = sectionMap.get(id);
  if (!item) throw new Error(`Missing About section: ${id}`);
  return item;
};

const explorations = ['development', 'cybersecurity', 'systems'].map(section);
const ai = section('ai');
const identity = section('identity');
const closing = section('closing');
const process = locale === 'fr'
  ? ['Idée', 'Expérimentation', 'Prototype', 'Tests', 'Améliorations']
  : ['Idea', 'Experimentation', 'Prototype', 'Testing', 'Improvements'];
---

<BaseLayout title={locale === 'fr' ? 'À propos' : 'About'} description={about.description} locale={locale} alternatePath={getRoute(locale === 'en' ? 'fr' : 'en', 'about')}>
  <div class="about-page">
    <header class="about-hero container">
      <div class="about-hero__copy">
        <h1>{about.title}</h1>
        <p class="about-intro">{about.intro}</p>
      </div>
      <AboutSignal />
    </header>

    <section id="explorations" class="explorations-section container" aria-labelledby="explorations-title">
      <header class="section-heading">
        <h2 id="explorations-title">{copy.domainsTitle}</h2>
        <p>{copy.domainsLead}</p>
      </header>
      <div class="exploration-list">
        {explorations.map((item) => (
          <article class="exploration-item">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="ai-process" class="ai-section" aria-labelledby="ai-title">
      <div class="container ai-inner">
        <header class="ai-heading">
          <h2 id="ai-title">{ai.title}</h2>
        </header>
        <div class="ai-copy"><p>{ai.body}</p></div>
        <ol class="process-line" aria-label={locale === 'fr' ? 'Processus de création' : 'Creation process'}>
          {process.map((step, index) => (
            <li>
              <span class="process-index type-metadata" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="process-label">{step}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="identity" class="identity-section container" aria-labelledby="identity-title">
      <header class="identity-heading">
        <h2 id="identity-title">{identity.title}</h2>
        <p>{identity.body}</p>
      </header>
      <div class="about-apps">
        {apps.map((app) => (
          <article class="about-app">
            <AppIcon app={app} size="small" />
            <div>
              <h3>{app.name}</h3>
              <p>{app.description}</p>
              <a href={getRoute(locale, 'product', app.slug)}>{locale === 'fr' ? 'Découvrir' : 'Discover'} {app.name}</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="closing" class="closing-section" aria-labelledby="closing-title">
      <div class="container closing-inner">
        <div>
          <h2 id="closing-title">{closing.title}</h2>
          <p>{closing.body}</p>
        </div>
        <div class="closing-actions">
          <a class="button button--primary" href={getRoute(locale, 'apps')}>{copy.appsCta}</a>
          <a class="button button--secondary" href={about.contact.href} rel="me">{about.contact.text}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: var(--space-7);
  }

  .about-hero h1 {
    max-width: 15ch;
    margin-bottom: var(--space-4);
    font-size: clamp(2.75rem, 6vw, 5.25rem);
    line-height: 1.03;
  }

  .about-intro { max-width: 51ch; margin: 0; color: var(--muted); }
  .explorations-section { padding-block: var(--space-7); border-block-start: 1px solid var(--line); }
  .section-heading { margin-bottom: var(--space-5); }
  .section-heading h2, .identity-heading h2, .closing-inner h2 { margin-bottom: var(--space-3); }
  .section-heading p, .identity-heading p, .closing-inner p { max-width: 56ch; margin: 0; color: var(--muted); }

  .exploration-list { display: grid; gap: var(--space-5); }
  .exploration-item { padding-block-start: var(--space-4); border-block-start: 2px solid var(--field-blue); }
  .exploration-item h3 { margin-bottom: var(--space-2); }
  .exploration-item p { max-width: 56ch; margin: 0; color: var(--muted); }

  .ai-section { background: var(--ink); color: var(--paper-strong); }
  .ai-inner { display: grid; gap: var(--space-5); padding-block: var(--space-7); }
  .ai-heading h2 { margin: 0; color: inherit; font-size: var(--step-3); }
  .ai-copy p { max-width: 60ch; margin: 0; }

  .process-line {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: var(--space-4) 0 0;
    border-block-start: 1px solid oklch(75% 0.03 263 / 0.4);
    list-style: none;
  }

  .process-line li { display: flex; gap: var(--space-2); align-items: baseline; }
  .process-index { color: var(--field-blue); font-size: var(--step--1); }

  .identity-section { display: grid; gap: var(--space-5); padding-block: var(--space-7); }
  .about-app { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-4); border-block-start: 1px solid var(--line); }
  .about-app h3 { margin-bottom: var(--space-2); }
  .about-app p { max-width: 50ch; margin: 0; color: var(--muted); }
  .about-app a { display: inline-flex; min-height: 2.75rem; align-items: center; color: var(--blue-text); font-weight: 650; text-underline-offset: 0.25em; }

  .closing-section { background: var(--signal-field); }
  .closing-inner { display: grid; gap: var(--space-5); padding-block: var(--space-7); }
  .closing-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }

  @media (min-width: 52rem) {
    .about-hero, .identity-section, .ai-inner, .closing-inner { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
    .exploration-list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
    .process-line { grid-column: 1 / -1; }
    .closing-actions { justify-content: flex-end; }
  }
</style>
