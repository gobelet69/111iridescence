---
import { PORTAL_LINK } from '../config/site';
import { type Locale, ui } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = ui(locale);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span class="signature type-identity">111iridescence.</span>
    <nav class="type-navigation" aria-label={copy.footerNavigation}>
      <ul>
        <li><a href="https://github.com/gobelet69" rel="me">GitHub</a></li>
        <li class="portal-link"><a href={PORTAL_LINK.href}>{copy.portal}</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer { margin-top: auto; background: var(--ink); color: var(--paper-strong); }

  .footer-inner {
    display: flex;
    min-height: 6rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
  }

  .signature { font-size: var(--step--1); font-weight: 700; }
  ul { display: flex; gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  a { display: inline-flex; min-height: 2.75rem; align-items: center; font-size: var(--step--1); text-underline-offset: 0.25em; }
  a:hover { color: var(--field-blue); }
  a:focus-visible { outline-color: var(--field-blue); }
</style>
