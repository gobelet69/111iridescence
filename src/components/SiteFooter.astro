---
import { PORTAL_LINK } from '../config/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span class="signature type-identity">111iridescence.</span>
    <nav class="type-navigation" aria-label="Liens secondaires">
      <ul>
        <li><a href="https://github.com/gobelet69" rel="me">GitHub</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        <li class="portal-link"><a href={PORTAL_LINK.href}>{PORTAL_LINK.label}</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .footer-inner {
    display: flex;
    min-height: 6.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .signature {
    font-size: var(--step--1);
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.75rem);
    list-style: none;
  }

  a {
    font-size: var(--step--1);
    text-underline-offset: 0.3em;
  }

  .portal-link {
    padding-inline-start: clamp(0.25rem, 1.5vw, 1rem);
    border-inline-start: 1px solid var(--line);
  }

  .portal-link a {
    color: var(--muted);
    font-size: 0.75rem;
  }

  @media (max-width: 31rem) {
    .footer-inner {
      min-height: auto;
      padding-block: var(--space-5);
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
