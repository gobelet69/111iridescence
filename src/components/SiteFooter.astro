---
import { PORTAL_LINK } from '../config/site';
import { type Locale, ui } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = ui(locale);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span class="signature type-identity">111iridescence.</span>
    <nav class="type-navigation" aria-label={copy.footerNavigation}>
      <ul>
        <li><a href="https://github.com/gobelet69" rel="me">GitHub</a></li>
        <li class="portal-link"><a href={PORTAL_LINK.href}>{copy.portal}</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: auto;
    border-top: 1px solid var(--glass-line);
    background: color-mix(in srgb, var(--paper-strong) 40%, transparent);
    color: var(--muted);
  }

  .site-footer::before {
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, oklch(100% 0 0 / 0.8) 25%, oklch(100% 0 0 / 0.8) 75%, transparent);
    content: '';
    pointer-events: none;
  }

  .footer-inner {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .signature {
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 700;
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.75rem);
    list-style: none;
  }

  a {
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  a:hover {
    color: var(--ink);
  }

  .portal-link {
    padding-inline-start: clamp(0.5rem, 1.5vw, 1.25rem);
    border-inline-start: 1px solid var(--line);
  }

  .portal-link a {
    color: var(--muted);
    font-size: 0.78rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--glass);
    border: 1px solid var(--glass-line);
  }

  .portal-link a:hover {
    color: var(--ink);
    border-color: var(--line);
  }

  @media (max-width: 31rem) {
    .footer-inner {
      min-height: auto;
      padding-block: var(--space-5);
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
