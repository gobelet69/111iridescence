---
import { getRoute, type Locale, ui } from '../i18n';
import BrandMark from './BrandMark.astro';

interface Props { locale: Locale; currentPath: string; alternatePath: string }
const { locale, currentPath, alternatePath } = Astro.props;
const copy = ui(locale);
const nav = [
  { href: getRoute(locale, 'apps'), label: copy.nav.apps, active: /^(?:\/fr)?\/apps(?:\/|$)/.test(currentPath) },
  { href: getRoute(locale, 'about'), label: copy.nav.about, active: currentPath.replace(/\/$/, '') === getRoute(locale, 'about') },
];
---

<header class="site-header">
  <div class="container header-inner">
    <BrandMark href={getRoute(locale, 'home')} />
    <nav class="type-navigation" aria-label={locale === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={item.active ? (currentPath.replace(/\/$/, '') === item.href ? 'page' : 'location') : undefined}>{item.label}</a></li>
        ))}
        <li class="language-switch" aria-label={copy.language.label}>
          <a data-language-link href={locale === 'en' ? currentPath + Astro.url.search : alternatePath} lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined} aria-label={copy.language.en}>EN</a>
          <span aria-hidden="true">/</span>
          <a data-language-link href={locale === 'fr' ? currentPath + Astro.url.search : alternatePath} lang="fr" hreflang="fr" aria-current={locale === 'fr' ? 'page' : undefined} aria-label={copy.language.fr}>FR</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  for (const link of document.querySelectorAll('[data-language-link]')) {
    const target = new URL(link.href);
    target.search = window.location.search;
    target.hash = window.location.hash;
    link.href = `${target.pathname}${target.search}${target.hash}`;
  }
</script>

<style>
  .site-header { border-block-end: 1px solid var(--line); background: var(--paper-strong); }

  .header-inner {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }

  ul {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 2vw, 1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: var(--space-2);
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 650;
    text-decoration: none;
  }

  a:hover { color: var(--blue-text); text-decoration: underline; text-underline-offset: 0.25em; }
  a[aria-current] { color: var(--blue-text); }
  li > a[aria-current] { box-shadow: inset 0 -2px var(--blue-text); }

  .language-switch {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
  }

  .language-switch span { display: none; }
  .language-switch a { width: 2.75rem; justify-content: center; }
  .language-switch a[aria-current] { background: var(--field-blue); border-radius: calc(var(--radius-sm) - 1px); }

  @media (max-width: 34rem) {
    .header-inner { flex-wrap: wrap; padding-block: var(--space-2); }
    .header-inner > :global(.brand-mark) { min-height: 2.75rem; }
    nav { width: 100%; }
    .language-switch { margin-inline-start: auto; }
  }
</style>
