---
import { getRoute, type Locale, ui } from '../i18n';
import BrandMark from './BrandMark.astro';

interface Props { locale: Locale; currentPath: string; alternatePath: string }
const { locale, currentPath, alternatePath } = Astro.props;
const copy = ui(locale);
const nav = [
  { href: getRoute(locale, 'apps'), label: copy.nav.apps },
  { href: getRoute(locale, 'about'), label: copy.nav.about },
];
---

<header class="site-header">
  <div class="container header-inner">
    <BrandMark href={getRoute(locale, 'home')} />
    <nav class="type-navigation" aria-label={locale === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li class="language-switch" aria-label={copy.language.label}>
          <a data-language-link href={locale === 'en' ? currentPath + Astro.url.search : alternatePath} lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined} aria-label={copy.language.en}>EN</a>
          <span aria-hidden="true">/</span>
          <a data-language-link href={locale === 'fr' ? currentPath + Astro.url.search : alternatePath} lang="fr" hreflang="fr" aria-current={locale === 'fr' ? 'page' : undefined} aria-label={copy.language.fr}>FR</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  for (const link of document.querySelectorAll('[data-language-link]')) {
    const target = new URL(link.href);
    target.search = window.location.search;
    target.hash = window.location.hash;
    link.href = `${target.pathname}${target.search}${target.hash}`;
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--glass-line);
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(24px) saturate(1.3);
    -webkit-backdrop-filter: blur(24px) saturate(1.3);
  }

  .header-inner {
    display: flex;
    min-height: 4.75rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
    list-style: none;
  }

  .language-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.2rem 0.35rem;
    border: 1px solid var(--glass-line);
    border-radius: var(--radius-pill);
    background: var(--glass);
    color: var(--muted);
  }

  .language-switch a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    font-size: 0.78rem;
    font-weight: 650;
    text-decoration: none;
    line-height: 1;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .language-switch a[aria-current="page"] {
    background: var(--paper-strong);
    color: var(--ink);
    box-shadow: 0 1px 2px oklch(0% 0 0 / 0.08);
  }

  .language-switch span {
    display: none;
  }

  a {
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 650;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  a:hover {
    color: var(--ink);
  }

  nav > ul > li > a:not([data-language-link]) {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.35rem 0.6rem;
  }

  nav > ul > li > a:not([data-language-link])::after {
    position: absolute;
    bottom: 0.5rem;
    left: 0.6rem;
    right: 0.6rem;
    height: 1.5px;
    background: var(--ink);
    content: '';
    opacity: 0;
    transform: scaleX(0.7);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  nav > ul > li > a:not([data-language-link]):hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  @media (max-width: 32rem) {
    .header-inner {
      min-height: auto;
      padding-block: var(--space-3);
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-2);
    }

    .header-inner > nav {
      display: flex;
      width: 100%;
    }

    .header-inner > nav > ul {
      width: 100%;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
    }

    nav > ul > li > a:not([data-language-link]) {
      min-height: 2.5rem;
      padding: 0.25rem 0.4rem;
    }
  }
</style>
