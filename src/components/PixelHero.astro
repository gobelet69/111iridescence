---
import { SITE } from '../config/site';
---

<section class="pixel-hero" data-pixel-hero aria-labelledby="pixel-title">
  <canvas data-pixel-canvas data-render-state="loading" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <div class="pixel-stage" data-pixel-stage>
      <h1 id="pixel-title">{SITE.heroTitle}</h1>
    </div>

    <div class="hero-meta">
      <p>{SITE.heroDescription}</p>
      <p class="interaction-hint type-metadata" aria-hidden="true">le signal n’est jamais fixe.</p>
    </div>
  </div>
</section>

<script>
  import { mountPixelTitle } from '../scripts/pixel-title';

  const root = document.querySelector<HTMLElement>('[data-pixel-hero]');
  if (root) mountPixelTitle(root);
</script>

<style>
  .pixel-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(48rem, calc(100svh - 4.75rem));
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 19% 24%, color-mix(in srgb, var(--blue) 12%, transparent), transparent 28rem),
      radial-gradient(circle at 77% 66%, color-mix(in srgb, var(--coral) 15%, transparent), transparent 29rem),
      var(--paper);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(calc(100% - 2rem), 90rem);
    min-height: inherit;
    margin-inline: auto;
    padding-block: clamp(1.5rem, 4vw, 3.5rem);
    grid-template-rows: 1fr auto;
  }

  .pixel-stage {
    position: relative;
    display: grid;
    min-height: clamp(16rem, 42vw, 31rem);
    place-items: center;
  }

  h1 {
    max-width: none;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2rem, 8.8vw, 8rem);
    font-weight: 700;
    letter-spacing: -0.075em;
    line-height: 0.9;
    text-align: center;
    white-space: nowrap;
    transition: opacity 180ms ease;
  }

  canvas {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .pixel-hero[data-pixel-ready] h1 {
    opacity: 0;
  }

  .pixel-hero[data-pixel-ready] canvas {
    opacity: 1;
  }

  .hero-meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .hero-meta p {
    margin: 0;
  }

  .hero-meta > p:first-child {
    max-width: 40ch;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .interaction-hint {
    color: var(--muted);
    font-size: var(--step--1);
  }

  @media (max-width: 40rem) {
    .pixel-hero {
      min-height: min(42rem, calc(100svh - 7.5rem));
    }

    .pixel-stage {
      min-height: 16rem;
    }

    h1 {
      font-size: clamp(1.75rem, 10.4vw, 3.6rem);
      letter-spacing: -0.08em;
    }

    .hero-meta {
      display: grid;
    }

    .interaction-hint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h1,
    canvas {
      transition: none;
    }

    .interaction-hint {
      display: none;
    }
  }
</style>
