---
import { SITE } from '../config/site';
---

<section class="pixel-hero" data-pixel-hero aria-labelledby="pixel-title">
  <canvas data-pixel-canvas data-render-state="loading" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <div class="pixel-stage" data-pixel-stage>
      <h1 id="pixel-title">{SITE.heroTitle}</h1>
    </div>
  </div>
</section>

<script>
  import { mountPixelTitle } from '../scripts/pixel-title';

  const root = document.querySelector<HTMLElement>('[data-pixel-hero]');
  if (root) mountPixelTitle(root);
</script>

<style>
  .pixel-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(15rem, 30vw, 28rem);
    border-block-end: 1px solid var(--line);
    /* Opaque stops preserve the gradient without WebKit artifacts behind the canvas. */
    background: radial-gradient(ellipse at 63% 12% in srgb, var(--paper-strong), var(--field-blue) 70%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(calc(100% - 2rem), 90rem);
    min-height: inherit;
    margin-inline: auto;
    padding-block: var(--space-5);
    grid-template-rows: 1fr;
  }

  .pixel-stage {
    position: relative;
    display: grid;
    min-height: 0;
    place-items: center;
  }

  h1 {
    max-width: none;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2rem, 8.8vw, 8rem);
    font-weight: 700;
    letter-spacing: -0.075em;
    line-height: 0.9;
    text-align: center;
    white-space: nowrap;
    transition: opacity 180ms ease;
  }

  canvas {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .pixel-hero[data-pixel-ready] h1 {
    opacity: 0;
  }

  .pixel-hero[data-pixel-ready] canvas {
    opacity: 1;
  }

  @media (max-width: 40rem) {
    h1 {
      font-size: clamp(1.75rem, 10.4vw, 3.6rem);
      letter-spacing: -0.08em;
    }

  }

  @media (max-width: 23rem) {
    .pixel-hero { min-height: 12rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    h1,
    canvas {
      transition: none;
    }

  }
</style>
