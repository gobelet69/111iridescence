---
import type { MarkdownHeading } from 'astro';
import type { BlogEntry } from '../lib/blog';
import CodeCopy from '../components/CodeCopy.astro';
import SeriesList from '../components/SeriesList.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import BaseLayout from './BaseLayout.astro';
import { formatPublishedDate, readingMinutes } from '../lib/blog';

interface Props {
  entry: BlogEntry;
  headings: MarkdownHeading[];
  seriesEntries?: BlogEntry[];
}

const { entry, headings, seriesEntries = [] } = Astro.props;
const isArticle = entry.data.format === 'article';
const minutes = readingMinutes(entry.body ?? '');
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  image={entry.data.socialImage}
>
  <article class:list={['publication', 'container', entry.data.format]}>
    <header class="publication-header">
      <p class="publication-kind type-metadata">{isArticle ? 'Article' : 'Note'}</p>
      <h1>{entry.data.title}</h1>
      <p class="description">{entry.data.description}</p>
      <div class="publication-meta type-metadata">
        <time datetime={entry.data.publishedAt.toISOString()}>{formatPublishedDate(entry.data.publishedAt)}</time>
        {entry.data.updatedAt && (
          <span>Mis à jour le {formatPublishedDate(entry.data.updatedAt)}</span>
        )}
        {isArticle && <span>{minutes} min de lecture</span>}
      </div>
      <TagList tags={entry.data.tags} />
    </header>

    {isArticle ? (
      <div class="article-grid">
        <div class="prose publication-body"><slot /></div>
        <aside class="reading-rail">
          <TableOfContents headings={headings} />
        </aside>
      </div>
    ) : (
      <div class="prose publication-body"><slot /></div>
    )}

    <SeriesList entries={seriesEntries} currentSlug={entry.data.slug} />
    <CodeCopy />
  </article>
</BaseLayout>

<style>
  .publication {
    padding-block: var(--space-7) var(--space-8);
  }

  .publication-header {
    max-width: var(--prose);
    margin: 0 auto var(--space-7);
  }

  .publication-kind {
    margin-bottom: var(--space-3);
    color: var(--presence);
    font-size: var(--step--1);
  }

  h1 {
    margin-bottom: var(--space-4);
  }

  .description {
    margin-bottom: var(--space-4);
    color: var(--muted);
    font-size: var(--step-1);
  }

  .publication-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .publication-body {
    margin-inline: auto;
  }

  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--prose)) minmax(12rem, 16rem);
    justify-content: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .reading-rail {
    min-width: 0;
  }

  .reading-rail > :global(nav) {
    position: sticky;
    top: var(--space-5);
  }

  @media (max-width: 58rem) {
    .article-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .reading-rail {
      grid-row: 1;
      max-width: var(--prose);
      width: 100%;
      margin-inline: auto;
    }
  }
</style>
