---
import AppIcon from '../../components/apps/AppIcon.astro';
import AppScreenshot from '../../components/apps/AppScreenshot.astro';
import { getApps } from '../../data/apps';
import { getRoute, type Locale } from '../../i18n';
import { pageCopy } from '../../i18n/pages';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = pageCopy(locale).catalog;
const apps = getApps(locale);
---

<BaseLayout title={copy.title} description={copy.description} locale={locale} alternatePath={getRoute(locale === 'en' ? 'fr' : 'en', 'apps')}>
  <header class="catalog-hero">
    <div class="container">
      <h1>{copy.title}</h1>
      <p>{copy.lead}</p>
    </div>
  </header>
  <section class="catalog container" aria-label={copy.label}>
    {apps.map((app) => (
      <article class:list={['catalog-card', `catalog-card--${app.accent}`, `catalog-card--${app.slug}`]}>
        <div class="catalog-card__copy">
          <AppIcon app={app} size="small" />
          <p class="type-metadata">{app.architecture} · {app.platform}</p>
          <h2>{app.name}</h2>
          <p>{app.description}</p>
          <a class="button button--secondary" href={getRoute(locale, 'product', app.slug)}>{copy.discover} {app.name}</a>
        </div>
        <div class="catalog-card__preview"><AppScreenshot screenshot={app.primaryScreenshot} /></div>
      </article>
    ))}
  </section>
  <aside class="catalog-future container">
    <h2>{copy.futureTitle}</h2>
    <p>{copy.future}</p>
  </aside>
</BaseLayout>

<style>
  .catalog-hero {
    padding-block: var(--space-7);
    border-block-end: 1px solid var(--line);
    background: var(--signal-field);
  }

  .catalog-hero h1 { margin-bottom: var(--space-3); text-wrap: balance; }
  .catalog-hero p { max-width: 48ch; margin: 0; color: var(--muted); font-size: var(--step-1); }

  .catalog { padding-block: var(--space-5) var(--space-7); }

  .catalog-card {
    --catalog-field: var(--field-violet);
    display: grid;
    min-width: 0;
    align-items: center;
    gap: clamp(1.25rem, 5vw, 4rem);
    padding-block: var(--space-5);
  }

  .catalog-card + .catalog-card { border-block-start: 1px solid var(--line); }
  .catalog-card--blue { --catalog-field: var(--field-blue); }
  .catalog-card--cyan { --catalog-field: var(--field-cyan); }
  .catalog-card--resource-guard { --catalog-field: var(--field-green); }

  .catalog-card__copy { min-width: 0; }
  .catalog-card__copy .type-metadata { margin: var(--space-3) 0 var(--space-2); color: var(--muted); font-size: var(--step--1); }
  .catalog-card h2 { margin-bottom: var(--space-2); font-size: var(--step-2); }
  .catalog-card__copy p:not(.type-metadata) { max-width: 52ch; margin-bottom: var(--space-3); color: var(--muted); }

  .catalog-card__preview {
    display: grid;
    min-width: 0;
    place-items: center;
    padding: clamp(1rem, 3vw, 2.5rem);
    border-radius: var(--radius);
    background: var(--catalog-field);
  }

  .catalog-card__preview :global(.app-shot) { max-inline-size: 26rem; }
  .catalog-card--resource-guard .catalog-card__preview :global(.app-shot) { max-inline-size: 15rem; }

  .catalog-future { margin-block-end: var(--space-8); padding: var(--space-5); border-inline-start: 3px solid var(--blue-text); background: var(--field-blue); }
  .catalog-future h2 { margin-bottom: var(--space-2); font-size: var(--step-1); }
  .catalog-future p { margin: 0; color: var(--muted); }

  @media (min-width: 46rem) {
    .catalog-card { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); }
  }
</style>
