---
import AppIcon from '../../components/apps/AppIcon.astro';
import AppScreenshot from '../../components/apps/AppScreenshot.astro';
import { getApps } from '../../data/apps';
import { getRoute, type Locale } from '../../i18n';
import { pageCopy } from '../../i18n/pages';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = pageCopy(locale).catalog;
const apps = getApps(locale);
---

<BaseLayout title={copy.title} description={copy.description} locale={locale} alternatePath={getRoute(locale === 'en' ? 'fr' : 'en', 'apps')}>
  <header class="catalog-hero container">
    <h1>{copy.title}</h1>
    <p>{copy.lead}</p>
  </header>
  <section class="catalog container" aria-label={copy.label}>
    {apps.map((app) => (
      <article class:list={['catalog-card', `catalog-card--${app.accent}`, `catalog-card--${app.slug}`]}>
        <div class="catalog-card__copy">
          <AppIcon app={app} size="small" />
          <p class="type-metadata">{app.architecture} · {app.platform}</p>
          <h2>{app.name}</h2>
          <p>{app.description}</p>
          <a class="button button--secondary" href={getRoute(locale, 'product', app.slug)}>{copy.discover} {app.name}</a>
        </div>
        <AppScreenshot screenshot={app.primaryScreenshot} />
      </article>
    ))}
  </section>
  <aside class="catalog-future container">
    <h2>{copy.futureTitle}</h2>
    <p>{copy.future}</p>
  </aside>
</BaseLayout>

<style>
  .catalog-hero {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .catalog-hero h1 {
    margin-bottom: var(--space-4);
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .catalog-hero > p:last-child {
    max-width: 48ch;
    margin: 0;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .catalog {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: var(--space-8);
  }

  .catalog-card {
    --card-accent: var(--violet);
    --card-accent-text: var(--violet-text);
    display: grid;
    min-width: 0;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding: clamp(1.75rem, 4vw, 3.5rem);
    border: 1px solid var(--glass-line);
    border-radius: var(--radius-large);
    background:
      radial-gradient(circle at 10% 20%, color-mix(in srgb, var(--card-accent) 8%, transparent), transparent 24rem),
      linear-gradient(135deg, var(--glass), color-mix(in srgb, var(--card-accent) 4%, var(--glass)));
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(16px);
    overflow: hidden;
    transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .catalog-card:hover {
    border-color: var(--line);
    transform: translateY(-2px);
    box-shadow: var(--shadow-window);
  }

  .catalog-card--blue {
    --card-accent: var(--blue);
    --card-accent-text: var(--blue-text);
  }

  .catalog-card--cyan,
  .catalog-card--iridescence-installer {
    --card-accent: var(--cyan);
    --card-accent-text: var(--cyan-text);
  }

  .catalog-card--resource-guard {
    --card-accent: var(--presence);
    --card-accent-text: var(--presence-text);
  }

  .catalog-card__copy {
    min-width: 0;
  }

  .catalog-card__copy > .type-metadata {
    margin: var(--space-4) 0 var(--space-2);
    color: var(--card-accent-text);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .catalog-card h2 {
    margin-bottom: var(--space-3);
    font-size: var(--step-2);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .catalog-card__copy > p:not(.type-metadata) {
    color: var(--muted);
    font-size: var(--step-0);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    text-wrap: pretty;
  }

  .catalog-card .button {
    margin-top: var(--space-2);
  }

  .catalog-future {
    max-width: 44rem;
    margin-inline: auto;
    margin-bottom: var(--space-8);
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--glass-line);
    border-radius: var(--radius-large);
    background: var(--glass);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(14px);
    text-align: center;
  }

  .catalog-future .type-metadata {
    color: var(--violet-text);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .catalog-future h2 {
    margin-bottom: var(--space-3);
    font-size: var(--step-1);
    letter-spacing: -0.03em;
  }

  .catalog-future > p:last-child {
    max-width: 50ch;
    margin-inline: auto;
    color: var(--muted);
    line-height: 1.6;
  }

  @media (min-width: 58rem) {
    .catalog-card {
      grid-template-columns: minmax(18rem, 0.78fr) minmax(0, 1.22fr);
    }
    .catalog-card:nth-child(even) {
      grid-template-columns: minmax(0, 1.22fr) minmax(18rem, 0.78fr);
    }
    .catalog-card:nth-child(even) .catalog-card__copy {
      grid-column: 2;
    }
    .catalog-card:nth-child(even) :global(.app-shot) {
      grid-row: 1;
      grid-column: 1;
    }
  }
</style>
