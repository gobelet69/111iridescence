---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRoute, type Locale } from '../i18n';
import { pageCopy } from '../i18n/pages';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = pageCopy(locale).notFound;
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  locale={locale}
  canonicalPath={getRoute(locale, 'notFound')}
  alternatePath={getRoute(locale === 'en' ? 'fr' : 'en', 'notFound')}
>
  <section class="not-found container">
    <div class="not-found-copy">
      <h1>{copy.title}</h1>
      <p>{copy.message}</p>
      <nav class="type-navigation" aria-label={copy.nav}>
        <ul>
          <li><a href={getRoute(locale, 'home')}>{copy.home} <span aria-hidden="true">→</span></a></li>
          <li><a href={getRoute(locale, 'apps')}>{copy.apps} <span aria-hidden="true">→</span></a></li>
          <li><a href={getRoute(locale, 'about')}>{copy.about} <span aria-hidden="true">→</span></a></li>
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: min(38rem, calc(100svh - 11rem));
    align-items: center;
    padding-block: var(--space-8);
  }

  .not-found-copy {
    max-width: 42rem;
  }

  h1 {
    margin-block-end: var(--space-5);
    letter-spacing: -0.045em;
  }

  p {
    margin-block-end: var(--space-7);
    color: var(--muted);
    font-size: var(--step-1);
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-6);
    list-style: none;
  }

  a {
    font-weight: 700;
    text-underline-offset: 0.3em;
  }

  a span {
    color: var(--blue);
    font-family: var(--font-display);
  }
</style>
