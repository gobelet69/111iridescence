---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { aggregateTags, getPublishedPosts } from '../../lib/blog';

const tags = aggregateTags(getPublishedPosts(await getCollection('blog')));
const maximumCount = Math.max(...tags.map(({ count }) => count), 1);
---

<BaseLayout title="Tags" description="Index des sujets abordés dans les articles et notes techniques.">
  <section class="tags-page container">
    <header class="tags-intro">
      <p class="eyebrow type-metadata">/tags</p>
      <h1>Tags</h1>
      <p>Les sujets du blog, classés par présence dans les publications.</p>
    </header>

    <ul class="tag-cloud">
      {tags.map(({ tag, count }) => (
        <li style={`--tag-share:${count / maximumCount}`}>
          <a href={`/tags/${tag}`} aria-label={`#${tag} ${count} publication${count > 1 ? 's' : ''}`}>
            <span class="tag-name type-metadata">#{tag}</span>
            <span class="tag-count">{count} publication{count > 1 ? 's' : ''}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .tags-page {
    padding-block: var(--space-7) var(--space-8);
  }

  .tags-intro {
    max-width: var(--prose);
    margin-bottom: var(--space-7);
  }

  .eyebrow {
    margin-bottom: var(--space-3);
    color: var(--presence);
    font-size: var(--step--1);
  }

  h1 {
    margin-bottom: var(--space-4);
  }

  .tags-intro p:last-child {
    color: var(--muted);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-5) 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  a {
    display: grid;
    gap: 0.15rem;
    min-width: 10rem;
    padding: calc(0.7rem + var(--tag-share) * 0.25rem) calc(0.9rem + var(--tag-share) * 0.4rem);
    border: 1px solid color-mix(in srgb, var(--blue) calc(20% + var(--tag-share) * 25%), var(--line));
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--paper-strong) 90%, var(--blue));
    text-decoration: none;
  }

  a:hover {
    border-color: var(--blue);
    background: color-mix(in srgb, var(--blue) 8%, var(--paper-strong));
  }

  .tag-name {
    color: var(--ink);
    font-size: calc(0.9rem + var(--tag-share) * 0.25rem);
  }

  .tag-count {
    color: var(--muted);
    font-size: 0.72rem;
  }
</style>
