---
import PixelHero from '../components/PixelHero.astro';
import ProductShowcase from '../components/apps/ProductShowcase.astro';
import { SITE } from '../config/site';
import { getApps } from '../data/apps';
import { getRoute, type Locale } from '../i18n';
import { pageCopy } from '../i18n/pages';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = pageCopy(locale).home;
const apps = getApps(locale);
---

<BaseLayout title={SITE.title} description={copy.description} locale={locale} alternatePath={getRoute(locale === 'en' ? 'fr' : 'en', 'home')}>
  <PixelHero />

  <section id="apps" class="apps-section" aria-labelledby="apps-title">
    <div class="apps-transition" aria-hidden="true"></div>
    <div class="container">
      <header class="apps-heading">
        <p class="type-metadata">{copy.eyebrow}</p>
        <h2 id="apps-title">{copy.title}</h2>
        <p>{copy.lead}</p>
      </header>
      {apps.map((app, index) => <ProductShowcase app={app} index={index} locale={locale} />)}
      <div class="future-apps">
        <p class="type-metadata">{copy.futureEyebrow}</p>
        <p>{copy.future}</p>
        <a href={getRoute(locale, 'apps')}>{copy.allApps} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .apps-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(circle at 8% 22%, color-mix(in srgb, var(--violet) 12%, transparent), transparent 28rem),
      radial-gradient(circle at 95% 68%, color-mix(in srgb, var(--blue) 13%, transparent), transparent 30rem),
      linear-gradient(180deg, var(--paper), var(--paper-strong) 18%, var(--paper));
  }

  .apps-transition {
    position: absolute;
    z-index: -1;
    top: -9rem;
    left: 50%;
    width: min(90rem, 120vw);
    height: 20rem;
    transform: translateX(-50%);
    background: radial-gradient(ellipse, color-mix(in srgb, var(--violet) 13%, transparent), transparent 68%);
    filter: blur(2rem);
    pointer-events: none;
  }

  .apps-heading {
    display: grid;
    padding-top: clamp(5rem, 11vw, 9rem);
    padding-bottom: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
  }

  .apps-heading > * {
    margin: 0;
  }

  .apps-heading > .type-metadata {
    color: var(--violet);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .apps-heading h2 {
    font-size: clamp(3.5rem, 10vw, 8rem);
    letter-spacing: -0.07em;
  }

  .apps-heading > p:last-child {
    max-width: 40ch;
    color: var(--muted);
    font-size: var(--step-1);
  }

  .future-apps {
    display: grid;
    max-width: 48rem;
    margin-inline: auto;
    padding-block: var(--space-8);
    text-align: center;
  }

  .future-apps p {
    margin-bottom: var(--space-2);
  }

  .future-apps .type-metadata {
    color: var(--violet);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .future-apps p:not(.type-metadata) {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--step-2);
  }

  .future-apps a {
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--step--1);
    text-underline-offset: 0.3em;
  }

  @media (min-width: 48rem) {
    .apps-heading {
      grid-template-columns: 0.7fr 1.3fr;
    }

    .apps-heading > .type-metadata,
    .apps-heading h2 {
      grid-column: 1;
    }

    .apps-heading > p:last-child {
      align-self: end;
      grid-row: 1 / span 2;
      grid-column: 2;
      justify-self: end;
    }
  }
</style>
