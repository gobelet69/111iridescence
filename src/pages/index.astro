---
import AppIcon from '../components/apps/AppIcon.astro';
import PixelHero from '../components/PixelHero.astro';
import ProductShowcase from '../components/apps/ProductShowcase.astro';
import { SITE } from '../config/site';
import { getApps } from '../data/apps';
import { getRoute, type Locale } from '../i18n';
import { pageCopy } from '../i18n/pages';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = pageCopy(locale).home;
const apps = getApps(locale);
---

<BaseLayout title={SITE.title} description={copy.description} locale={locale} alternatePath={getRoute(locale === 'en' ? 'fr' : 'en', 'home')}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': `${SITE.origin}/#organization`,
        name: '111iridescence',
        url: SITE.origin,
        logo: `${SITE.origin}/favicon.png`,
        description: copy.lead,
      },
      {
        '@type': 'WebSite',
        '@id': `${SITE.origin}/#website`,
        url: SITE.origin,
        name: '111iridescence',
        publisher: {
          '@id': `${SITE.origin}/#organization`,
        },
        inLanguage: ['en', 'fr'],
      },
    ],
  })} />
  <PixelHero />

  <section id="apps" class="apps-section" aria-labelledby="apps-title">
    <div class="container">
      <div class="apps-banner">
        <header class="apps-heading">
          <div>
            <h2 id="apps-title">{copy.title}</h2>
            <p class="apps-lead">{copy.lead}</p>
          </div>
          <a class="button button--secondary" href={getRoute(locale, 'apps')}>{copy.allApps}</a>
        </header>
        <nav class="app-index" aria-label={locale === 'fr' ? 'Accès direct aux applications' : 'Direct app access'}>
          {apps.map((app) => (
            <a href={getRoute(locale, 'product', app.slug)}>
              <AppIcon app={app} size="small" />
              <span>{app.shortName}</span>
            </a>
          ))}
        </nav>
      </div>
      {apps.map((app, index) => <ProductShowcase app={app} index={index} locale={locale} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .apps-section { padding-block: var(--space-5) var(--space-8); }

  .apps-banner {
    margin-block-end: var(--space-5);
    padding: clamp(1rem, 3vw, 2rem);
    border-radius: var(--radius-large);
    background: var(--line-subtle);
  }

  .apps-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-end: var(--space-4);
  }

  h2 { margin: 0; font-size: var(--step-3); }
  .apps-lead { margin: var(--space-2) 0 0; color: var(--muted); }

  .app-index {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .app-index a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    padding: 0.375rem 0.75rem 0.375rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper-strong);
    font-size: var(--step--1);
    font-weight: 650;
    text-decoration: none;
  }

  .app-index a:hover { border-color: var(--blue-text); color: var(--blue-text); }
  .app-index :global(.app-icon) { width: 1.75rem; height: 1.75rem; filter: none; }
</style>
