---
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutData from '../data/pages/about.json';
import { validateAboutPage } from '../lib/about';

const about = validateAboutPage(aboutData);
---

<BaseLayout
  title={about.title}
  description={about.description}
>
  <header class="about-header container">
    <p class="eyebrow type-metadata">{about.eyebrow}</p>
    <h1>{about.title}</h1>
    <p class="intro">{about.intro}</p>
  </header>

  <div class="about-grid container">
    {about.sections.map((section) => (
      <section aria-labelledby={`${section.id}-title`}>
        <h2 id={`${section.id}-title`}>{section.title}</h2>
        <p>{section.body}</p>
      </section>
    ))}
  </div>

  <aside class="about-contact container" aria-label="Ailleurs">
    <p class="type-metadata">{about.contact.label}</p>
    <a href={about.contact.href} rel="me">{about.contact.text} <span aria-hidden="true">↗</span></a>
  </aside>
</BaseLayout>

<style>
  .about-header {
    padding-block: var(--space-8);
  }

  .eyebrow {
    margin-bottom: var(--space-3);
    color: var(--presence);
    font-size: var(--step--1);
  }

  h1 {
    margin-bottom: var(--space-5);
    letter-spacing: -0.045em;
  }

  .intro {
    max-width: 59ch;
    margin: 0;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .about-grid {
    display: grid;
    border-top: 1px solid var(--line);
  }

  section {
    display: grid;
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--line);
    gap: var(--space-4);
  }

  h2,
  section p {
    margin: 0;
  }

  h2 {
    font-size: var(--step-1);
  }

  section p {
    max-width: 60ch;
    color: var(--muted);
  }

  .about-contact {
    display: flex;
    padding-block: var(--space-8);
    align-items: baseline;
    gap: var(--space-5);
  }

  .about-contact p {
    margin: 0;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .about-contact a {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    text-underline-offset: 0.25em;
  }

  .about-contact span {
    color: var(--blue);
  }

  @media (min-width: 48rem) {
    section {
      grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.3fr);
    }

    section p {
      grid-column: 2;
    }
  }
</style>
