{
  "name": "111iridescence",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "predev": "npm run sync:github:if-needed",
    "dev": "astro dev",
    "prebuild": "npm run sync:github:if-needed",
    "build": "astro build",
    "precheck": "npm run sync:github:if-needed",
    "preview": "astro preview",
    "check": "astro check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:worker": "playwright test --config playwright.worker.config.ts",
    "qa:i18n": "node scripts/capture-i18n-site.mjs",
    "test": "npm run check && npm run test:unit && npm run build && npm run test:e2e && npm run test:worker",
    "deploy": "npm run build && wrangler deploy",
    "sync:github": "node scripts/sync-github-projects.mjs",
    "sync:github:if-needed": "node scripts/sync-github-if-needed.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.8",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.5",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.62.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.164.0"
  }
}
